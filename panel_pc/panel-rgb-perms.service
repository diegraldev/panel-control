[Unit]
Description=Permisos RGB para el modo sleep del panel
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'chmod 666 /sys/class/leds/msi::kbd_backlight/brightness /sys/class/leds/razer::logo_backlight/brightness 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
